#!/bin/bash
# Forced command for the search.peptides CI deploy key (root authorized_keys, restrict).
# Accepts one argument: a 40-hex commit that is already on origin/main. Checks it
# out in /opt/search.peptides, then hands over to that commit's own
# deploy/after-checkout.sh, so deploy steps change with the code and this
# installed copy (/usr/local/bin/search-peptides-deploy) never has to.
# Nothing else is possible with that key.
set -euo pipefail
sha="${SSH_ORIGINAL_COMMAND:-}"
sha="${sha##* }"
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || { echo "search-peptides-deploy: expected a 40-hex sha" >&2; exit 2; }
cd /opt/search.peptides
git fetch -q origin main
git merge-base --is-ancestor "$sha" origin/main || { echo "search-peptides-deploy: $sha is not on origin/main" >&2; exit 3; }
git checkout -q main && git merge -q --ff-only "$sha"
echo "search-peptides-deploy: at $(git log --oneline -1)"
exec bash ./deploy/after-checkout.sh
